# Configuração local do servidor. Copie para .env e preencha no computador/host.
# Nunca envie o .env ao GitHub ou insira chaves no HTML.
TRADE_ASSISTANT_PASSWORD=
TRADE_AI_KEY=
TRADE_AI_MODEL=gpt-4.1-mini
# showmytrades: calendário público sem chave, cobertura informada pela API.
# forexfactory: feed semanal sem chave. fmp: exige chave e acesso ao endpoint.
TRADE_ECONOMIC_PROVIDER=forexfactory
TRADE_ECONOMIC_KEY=
TRADE_MARKET_KEY=
HOST=127.0.0.1
PORT=8080
# Produção: configure a origem HTTPS exata e um proxy TLS.
# TRADE_ALLOWED_ORIGIN=https://seu-dominio.example

# Nuvem multiusuário (opcional). Configure todas as variáveis antes de ativar.
# Execute server/cloud/schema.sql no SQL Editor do Supabase.
# Confirme o e-mail e configure SMTP antes de liberar cadastros públicos.
# ELITEX_CLOUD_ENABLED=true
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# ELITEX_ADMIN_EMAIL=seu-email@exemplo.com
# ELITEX_SESSION_SECRET=gere-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# TRADE_ALLOWED_ORIGIN=https://seu-site.onrender.com
